{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "entity_type",
    "action"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "recepcion"
          }
        },
        {
          "user_condition": {
            "role": "produccion"
          }
        },
        {
          "user_condition": {
            "role": "frio"
          }
        },
        {
          "user_condition": {
            "role": "despacho"
          }
        },
        {
          "user_condition": {
            "role": "calidad"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}