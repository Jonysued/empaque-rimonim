        "calibre",
        "envase",
        "tipo_pallet",
        "tara",
        "linea",
        "turno",
        "tunel",
        "camara",
        "muelle",
        "causa_descarte",
        "causa_retencion",
        "cliente",
        "especie"
      ]
    },
    "value": {
      "type": "string",
      "description": "Valor interno/clave"
    },
    "label": {
      "type": "string",
      "description": "Etiqueta legible"
    },
    "extra": {
      "type": "object",
      "description": "Config adicional: capacidad, temperatura, tara, bultos por pallet, etc."
    },
